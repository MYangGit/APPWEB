{
  "name": "haha",
  "displayName": "haha",
  "description": "haha",
  "activationEvents": [
    "onCommand:haha"
  ],
  "contributes": {
    "commands": [
      {
        "command": "haha",
        "title": "haha"
      }
    ],
    "configuration": [
      {
        "title": "Syslab Plot",
        "properties": {
          "plot.defaultInterpreterPath": {
