{
  "name": "CNOOC",
  "displayName": "CNOOC",
  "description": "这是一个中海油demo应用",
  "activationEvents": [
    "onCommand:CNOOC"
  ],
  "contributes": {
    "commands": [
      {
        "command": "CNOOC",
        "title": "CNOOC"
      }
    ],
    "configuration": [
      {
        "title": "Syslab Plot",
        "properties": {
          "plot.defaultInterpreterPath": {
            "scope": "application",
            "type": "string",
            "description": "Setting Interpreter Path for Syslab Plot"
          },
          "plot.mouseMoveInterval": {
            "scope": "application",
            "type": "number",
            "description": "%Setting Syslab mouse move rate%",
            "default": 300
          },
          "plot.mouseDragInterval": {
            "scope": "application",
            "type": "number",
            "description": "%Setting Syslab pressed mouse move rate%",
            "default": 30
          }
        }
      }
    ]
  },
  "repository": ".",
  "publisher": "TongYuan",
  "engines": {
    "vscode": "^1.75.1"
  },
  "categories": [
    "Other"
  ],
  "main": "./extensionDist/extension.js",
  "version": "1.0.0",
  "private": true,
  "icon": "app-icon.png",
  "devDependencies": {
    "@types/node": "^22.5.2"
  }
}