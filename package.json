{
  "name": "appdesigner",
  "description": "appdesigner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:app": "vite --mode app",
    "dev:web": "vite --mode web",
    "dev:dp": "lerna run dev --scope=desktop",
    "build": "vite build --mode pro",
    "build:web": "vite build --mode web",
    "build:qt": "vite build --mode qt",
    "build:dp": "vite build --mode dp && lerna run package:win --scope=desktop",
    "package:dp": "lerna run build:win --scope=desktop",
    "build:app": "webpack --config ./packages/syslab/webpack.config.js && vite build --mode app",
    "package:app": "vite build --mode app && webpack --config ./packages/syslab/webpack.config.js && node ./packages/syslab/build-package.js",
    "compile": "webpack --config ./packages/syslab/webpack.config.js",
    "server": "node server/index.js"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-python": "^6.1.6",
    "@element-plus/icons-vue": "^2.3.1",
    "@plutojl/lang-julia": "^0.11.0",
    "@visactor/vtable": "^1.18.3",
    "@visactor/vtable-gantt": "^1.18.3",
    "@visactor/vutils": "^1.0.6",
    "axios": "^1.8.1",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "defer-promise": "^3.0.0",
    "element-plus": "^2.6.1",
    "errantia": "^0.0.22",
    "express": "^4.19.2",
    "express-fileupload": "^1.5.0",
    "fs-extra": "^11.2.0",
    "highlight.js": "^11.10.0",
    "html-to-image": "^1.11.11",
    "js-cookie": "^3.0.5",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "marked": "^13.0.0",
    "marked-highlight": "^2.1.4",
    "mathjs": "^12.4.0",
    "monaco-editor": "^0.50.0",
    "nanoid": "^5.1.5",
    "pinia": "^2.1.7",
    "plotly.js-dist-min": "^2.30.1",
    "thememirror": "^2.0.1",
    "vue": "^3.4.15",
    "vue-codemirror": "^6.1.1",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.1",
    "@vitejs/plugin-vue": "^5.0.3",
    "lerna": "^8.2.2",
    "less": "^4.2.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "vite": "^5.0.11",
    "vite-awesome-svg-loader": "^1.3.5",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-string": "^1.2.3",
    "webpack": "^5.92.0",
    "webpack-cli": "^5.1.4"
  }
}
